---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/${lang}/marches-de-noel-ouverts/" title="French Christmas markets open near you" width="100%" height="1000" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the French Christmas market finder for free, 2026" description="Embed the 2026 French Christmas market finder for free with an iframe: markets open on a given day, within a given distance, with hours. For hotels, towns, clubs." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header slot="hero">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the Christmas market finder</h1>
    <p class="mt-3 text-lg text-navy-700">For a hotel, a holiday let, a town hall or a club: your visitors pick a day and a distance and see the markets open around them, with their hours.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p set:html={`For the French version, replace <code>/embed/en/</code> with <code>/embed/fr/</code>. Terms: the link and the DATAtourisme credit under the finder stay visible and unchanged; the service comes with no warranty. Your visitors' location, if they use it, stays on their device.`} />
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/marches-de-noel-ouverts/`} title="French Christmas markets open near you" width="100%" height="1000" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>

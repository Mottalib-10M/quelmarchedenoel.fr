---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL } from '../../data/site-config';
import { srcLink } from '../../lib/helpers';
import { profilePageSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const path = route('about', lang);
const title = 'Christmas market finder 2026: who publishes this site';
const description = 'Radif Partners publishes Quel Marché de Noël: a free finder of the French Christmas markets open on a given day in 2026, built on DATAtourisme open data.';
const s = (k: string, t: string) => srcLink(k, lang, t);
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'About', path }])]} breadcrumbs={[{ label: 'About' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>About Quel Marché de Noël</h1>
    <p>{AUTHOR_DESC.en}</p>
    <div class="not-prose text-xs font-medium uppercase tracking-wide text-navy-500">Independent site: not a tourist office or an organiser</div>
    <h2>Why this site exists</h2>
    <p>Finding a Christmas market for Saturday often means opening ten pages: the town has its site, the tourist office another, the press publishes rankings without hours, and directories hide their lists behind advertising. Yet French tourist offices enter almost all their markets in one public database. We read it, work out which markets are open on the day you pick and how far away they are, and show the answer without an account or intrusive ads.</p>
    <h2>A company, not a tourist office</h2>
    <p>{AUTHOR_NAME} is a company that builds tools from public data. It organises no market, rents no stall, sells no ticket and has no agreement with any exhibitor or town. The site uses no town or tourist-office logo.</p>
    <LegalIdentity lang={lang} />
    <h2>Sources</h2>
    <p>Listings come from <Fragment set:html={s('datatourisme', 'DATAtourisme')} />, published on <Fragment set:html={s('datagouv', 'data.gouv.fr')} /> under the <Fragment set:html={s('licence', 'Licence Ouverte 2.0')} />; Strasbourg and Lille, missing from that base, come from their official pages. The <a href={route('method', lang)}>method</a> explains the calculations and the <a href={route('editorial', lang)}>editorial policy</a> how we correct mistakes.</p>
    <h2>Write to us</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, if a date or an opening time is wrong or a market is missing. For a stall, contact the market organiser.</p>
  </article>
</PageLayout>

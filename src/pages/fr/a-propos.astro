---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL } from '../../data/site-config';
import { srcLink } from '../../lib/helpers';
import { profilePageSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'fr';
const path = route('about', lang);
const title = 'Marchés de Noël 2026 : qui publie ce chercheur de marchés';
const description = 'Radif Partners publie Quel Marché de Noël : un chercheur gratuit des marchés de Noël 2026 ouverts tel jour, bâti sur les données ouvertes DATAtourisme.';
const s = (k: string, t: string) => srcLink(k, lang, t);
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'Accueil', path: route('home', lang) }, { name: 'À propos', path }])]} breadcrumbs={[{ label: 'À propos' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>À propos de Quel Marché de Noël</h1>
    <p>{AUTHOR_DESC.fr}</p>
    <div class="not-prose text-xs font-medium uppercase tracking-wide text-navy-500">Site indépendant : ni office de tourisme, ni organisateur</div>
    <h2>Pourquoi ce site existe</h2>
    <p>Chercher un marché de Noël pour samedi revient souvent à ouvrir dix pages : la ville a son site, l'office de tourisme le sien, les médias publient des palmarès sans horaires, et les annuaires cachent leurs listes derrière la publicité. Les offices de tourisme saisissent pourtant presque tous leurs marchés dans une base publique. Nous la lisons, nous calculons qui est ouvert le jour choisi et à quelle distance, et nous rendons la réponse lisible sans compte ni publicité intrusive.</p>
    <h2>Une entreprise, pas un office de tourisme</h2>
    <p>{AUTHOR_NAME} est une entreprise qui construit des outils à partir de données publiques. Elle n'organise aucun marché, ne loue aucun chalet, ne vend aucun billet et n'a aucun accord avec un exposant ou une ville. Le site n'utilise aucun logo de ville ni d'office de tourisme.</p>
    <LegalIdentity lang={lang} />
    <h2>Les sources</h2>
    <p>Les fiches viennent de <Fragment set:html={s('datatourisme', 'DATAtourisme')} />, publiées sur <Fragment set:html={s('datagouv', 'data.gouv.fr')} /> sous <Fragment set:html={s('licence', 'Licence Ouverte 2.0')} /> ; Strasbourg et Lille, absentes de cette base, viennent de leurs pages officielles. La <a href={route('method', lang)}>méthode</a> explique les calculs et la <a href={route('editorial', lang)}>politique éditoriale</a> la façon dont nous corrigeons.</p>
    <h2>Écrivez-nous</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, si une date ou un horaire est faux ou si un marché manque. Pour un emplacement d'exposant, adressez-vous à l'organisateur du marché.</p>
  </article>
</PageLayout>
